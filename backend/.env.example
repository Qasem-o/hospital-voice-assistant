PORT=5000
MONGODB_URI=mongodb://localhost:27017/office-rental
JWT_SECRET=your_jwt_secret_key_here
OPENAI_API_KEY=your_openai_api_key_here
NODE_ENV=development

# Twilio Configuration (for phone call support)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://your-domain.com/api/voice/call-webhook

# Voice Recognition (optional - for advanced speech-to-text)
GOOGLE_CLOUD_SPEECH_KEY=your_google_speech_api_key
AWS_TRANSCRIBE_REGION=us-east-1

# Voice Synthesis (optional - for advanced text-to-speech)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus
